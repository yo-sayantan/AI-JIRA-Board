node_modules
*.log
.DS_Store
__pycache__/
.claude/
*.swap

# ── SECRETS — never commit real tokens ──────────────────────────────────────
# Real secrets live OUTSIDE this repo (~/.cursor/mcp-secrets.env). These rules are
# a backstop in case a filled-in copy ever lands inside the repo. The safe, empty
# setup/*.template files are NOT matched (they don't end in .env) and stay tracked.
*.env
*.env.local
secrets.env
mcp-secrets.env
!setup/*.template

# Build output (rebuild with: npm run build)
dist/

# Superseded legacy fetcher, kept locally but never published: it predates the
# config.json indirection and still has hardcoded identity/endpoints inside it.
# daily_fetch.py replaced it.
jira-intern/.fetch-intern.py

# ── jira-intern runtime data — company ticket content, NEVER commit ──
jira-intern/data.json
jira-intern/data.js
jira-intern/cache/
jira-intern/logs/
jira-intern/.state.json
jira-intern/_STATUS.md
jira-intern/.progress.json
jira-intern/.pr_overrides.json
jira-intern/*.lock
jira-intern/.*.lock
jira-intern/*.bak
jira-intern/.data.*
jira-intern/.tmp-*
jira-intern/jira-export.xml

# Retired legacy UI (pre-React) — rendered HTML holds real ticket content
jira-intern/status.html
jira-intern/tickets/
jira-intern/assets/

# Jira XML exports dropped in for import-jira-xml.mjs
my_dashboard.xml

# NOTE: jira-intern/config.json IS tracked — it's the single portability file.
# It holds your name/id/endpoints (no secrets; API keys live in the connector's
# secretsFile under ~). Swap its values before sharing the repo publicly.
