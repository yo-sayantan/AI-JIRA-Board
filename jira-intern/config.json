{
  "_readme": "TEMPLATE / FALLBACK — safe to commit, contains NO personal values. Your real config lives OUTSIDE the repo at ~/.ai/config.json, which always wins over this file. Resolution order: $AI_CONFIG_FILE > ~/.ai/config.json > this file. Create yours with: cp jira-intern/config.json ~/.ai/config.json (then edit it). Every key is documented in CONFIG.md next to this file.",

  "user": {
    "name": "Your Name (exactly as Jira displays it)",
    "accountId": "YOUR_CORP_ID",
    "email": "you@your-company.example"
  },

  "endpoints": {
    "jiraBase": "https://jira.your-company.example",
    "confluenceBase": "https://confluence.your-company.example",
    "bitbucketBase": "https://bitbucket.your-company.example"
  },

  "_excludeProjects": "Project keys to DROP from the board AND the completed archive entirely — even if a ticket was once assigned to you. The daily fetch and the weekly archive both honour this list. Leave [] to keep everything.",
  "excludeProjects": [],

  "connector": {
    "active": "cursor",
    "cursor": {
      "bin": "cursor-agent",
      "binFallbacks": ["~/.local/bin/cursor-agent"],
      "promptFlag": "-p",
      "extraArgs": ["--output-format", "text", "--force"],
      "modelFlag": "--model",
      "secretsFile": "~/.cursor/mcp-secrets.env",
      "apiKeyEnv": "CURSOR_API_KEY",
      "install": "curl https://cursor.com/install -fsS | bash"
    },
    "codex": {
      "bin": "codex",
      "binFallbacks": [],
      "promptFlag": "exec",
      "extraArgs": ["--full-auto"],
      "modelFlag": "--model",
      "secretsFile": "~/.codex/secrets.env",
      "apiKeyEnv": "OPENAI_API_KEY",
      "install": "npm install -g @openai/codex"
    },
    "claude": {
      "bin": "claude",
      "binFallbacks": [],
      "promptFlag": "-p",
      "extraArgs": ["--output-format", "text", "--dangerously-skip-permissions"],
      "modelFlag": "--model",
      "secretsFile": "~/.claude/secrets.env",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "install": "npm install -g @anthropic-ai/claude-code"
    }
  },

  "mcp": {
    "jira": { "enabled": true, "read": true, "write": false },
    "confluence": { "enabled": true, "read": true, "write": false },
    "bitbucket": { "enabled": true, "read": true, "write": false }
  },

  "models": {
    "main": "auto",
    "summary": "auto"
  },

  "timeouts": {
    "dailySec": 1800,
    "weeklySec": 7200,
    "summarySec": 900,
    "refreshSec": 600
  },

  "app": {
    "servePort": 4321,
    "requiredApprovals": 2,
    "branding": {
      "tagline": "Built to dodge JIRA · made with ☕ + a refresh button",
      "badgeText": "your-name.dev",
      "badgeUrl": "https://your-portfolio.example",
      "badgeTitle": "Made by You"
    }
  }
}
