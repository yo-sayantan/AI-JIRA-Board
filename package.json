{
  "name": "jira-board",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "Personal, beautiful JIRA replacement board. Renders the dump produced by the bundled jira-intern/ agent pipeline.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "npm run test:py && npm run test:js",
    "test:py": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:js": "vitest run",
    "demo:split": "node jira-intern/demo/build.mjs",
    "test:config": "python3 tests/test_config.py",
    "config:validate": "node jira-intern/local-runner/config.mjs validate",
    "preview": "vite preview",
    "serve": "node server/serve.mjs",
    "open": "open dist/index.html"
  },
  "dependencies": {
    "motion": "^13.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^5.0.3"
  }
}
