# Keep the build context small and reproducible. node_modules is never shipped: the
# image either installs its own (DIST_SOURCE=source) or needs none at all. dist/ IS
# allowed in — start-jira-board.sh builds it on the host and the image copies it
# (DIST_SOURCE=prebuilt), which keeps `npm ci` and its downloads out of the Docker VM.
.git
.gitignore
node_modules

# Editor / OS noise
.DS_Store
*.swap
*.log
**/__pycache__

# Cursor / agent local state (never needed in the image)
.cursor
.claude
agent-transcripts

# jira-intern runtime cruft — regenerated at runtime, must not be baked in.
# NOTE: data.json / data.js / config.json / *.py / prompts ARE kept on purpose so
# the board has content and the fetch scripts work the moment the container starts.
jira-intern/logs
jira-intern/cache
jira-intern/*.lock
jira-intern/.*.lock
jira-intern/.data.*
jira-intern/.tmp-*
jira-intern/.state.json
jira-intern/_STATUS.md
# PR report hand-off state — live files shared with the host enricher, never baked in.
jira-intern/reports/.enrich
jira-intern/reports/.enricher.*
jira-intern/reports/.ai-status.json
jira-intern/reports/.status.json
# Local model files are gigabytes — they reach the LLM container through a bind mount, never an image.
jira-intern/models/*.gguf
jira-intern/models/.registry.json
