#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  mcp-with-secrets.sh  —  TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────
#  The pattern that keeps tokens OUT of your MCP JSON config: this wrapper sources
#  your secrets file, then exec's the real MCP server. Point your MCP config's
#  "command" at this script (see setup/mcp.claude.json.template).
#
#  INSTALL
#    cp setup/mcp-with-secrets.sh.template ~/.local/bin/mcp-with-secrets.sh
#    chmod +x ~/.local/bin/mcp-with-secrets.sh
#
#  USAGE (from your MCP config)
#    "command": "/Users/you/.local/bin/mcp-with-secrets.sh",
#    "args": ["mcp-atlassian"]          # the real server + its args follow
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

# Where your real tokens live. Override with MCP_SECRETS_FILE if you keep it elsewhere.
ENV_FILE="${MCP_SECRETS_FILE:-$HOME/.cursor/mcp-secrets.env}"

if [[ -f "$ENV_FILE" ]]; then
  set -a            # export everything sourced, so the child server inherits it
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
else
  echo "mcp-with-secrets: missing secrets file: $ENV_FILE" >&2
  exit 1
fi

# Hand off to the real MCP server command passed as arguments.
exec "$@"
