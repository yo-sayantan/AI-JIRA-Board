#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  mcp-with-secrets.sh  —  TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────
#  The pattern that keeps tokens OUT of your MCP JSON config: this wrapper reads
#  your secrets file, exports its KEY=VALUE pairs, then exec's the real MCP
#  server. Point your MCP config's "command" at this script (see
#  setup/mcp.claude.json.template).
#
#  The file is PARSED, never sourced: blank lines and #-comments are skipped, a
#  leading "export " and a trailing CR are dropped, one layer of surrounding
#  quotes is removed, and values are taken literally — $VAR, $(…) and backticks
#  are not expanded, so nothing in the file can run code here.
#
#  INSTALL
#    cp setup/mcp-with-secrets.sh.template ~/.local/bin/mcp-with-secrets.sh
#    chmod +x ~/.local/bin/mcp-with-secrets.sh
#
#  USAGE (from your MCP config)
#    "command": "/Users/you/.local/bin/mcp-with-secrets.sh",
#    "args": ["mcp-atlassian"]          # the real server + its args follow
#
#  Optional: MCP_SECRETS_KEYS="JIRA_URL JIRA_PERSONAL_TOKEN" limits what is exported
#  (default: every well-formed KEY=VALUE line, since each MCP server needs its own set).
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

# Where your real tokens live. Override with MCP_SECRETS_FILE if you keep it elsewhere.
ENV_FILE="${MCP_SECRETS_FILE:-$HOME/.cursor/mcp-secrets.env}"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "mcp-with-secrets: missing secrets file: $ENV_FILE" >&2
  exit 1
fi

wanted="${MCP_SECRETS_KEYS:-}"
while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%$'\r'}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  case "$line" in ''|'#'*) continue ;; esac
  case "$line" in *=*) ;; *) continue ;; esac
  key="${line%%=*}"
  value="${line#*=}"
  key="${key%"${key##*[![:space:]]}"}"
  [[ "$key" =~ ^export[[:space:]]+(.*)$ ]] && key="${BASH_REMATCH[1]}"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  case "$value" in
    \"*\") value="${value#\"}"; value="${value%\"}" ;;
    \'*\') value="${value#\'}"; value="${value%\'}" ;;
  esac
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
  if [[ -n "$wanted" ]]; then
    case " $wanted " in *" $key "*) ;; *) continue ;; esac
  fi
  export "$key=$value"
done < "$ENV_FILE"

# Hand off to the real MCP server command passed as arguments.
exec "$@"
